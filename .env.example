# Application
NODE_ENV=development
PORT=3000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/task-manager-api

# JWT
ACCESS_JWT_SECRET=replace_with_a_long_random_access_secret
REFRESH_JWT_SECRET=replace_with_a_long_random_refresh_secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
JWT_ISSUER=task-manager-api

# Optional Cloudinary attachment upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional OpenAI, Anthropic, Gemini and OpenRouter API keys
OPENAI_API_KEY=replace_your_openai_api_key_here
ANTHROPIC_API_KEY=replace_your_anthropic_api_key_here
GEMINI_API_KEY=replace_your_gemini_api_key_here
OPENROUTER_API_KEY=replace_your_openrouter_api_key_here
AI_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENROUTER_MODEL=openai/gpt-oss-20b:free